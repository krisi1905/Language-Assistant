@model LanguageAssistant.Models.Word

@{
    ViewData["Title"] = "Изтриване на дума";
}

<h2>Изтриване на дума</h2>

<div class="alert alert-warning">
    Сигурен ли си, че искаш да изтриеш тази дума?
</div>

<div class="card mb-3">
    <div class="card-body">

        <h4>@Model.Text</h4>

        <p>
            <strong>Превод:</strong>
            @Model.Translation
        </p>

        <p>
            <strong>Синоними:</strong>
            @Model.Synonyms
        </p>

        <p>
            <strong>Ниво:</strong>
            @Model.DifficultyLevel
        </p>

    </div>
</div>

<form asp-controller="Words"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-danger">
        Да, изтрий думата
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Отказ
    </a>
</form>

