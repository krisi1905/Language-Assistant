@model List<LanguageAssistant.Models.Word>

@{
    ViewData["Title"] = "Флаш карти";
}


@if (!Model.Any())
{
    <div class="alert alert-info">
        Все още нямаш записани думи.

        <a asp-controller="Words" asp-action="Create">
            Добави първата си дума.
        </a>
    </div>
}
else
{
    <div class="text-center mt-4">

        <p id="cardCounter" class="text-muted"></p>

        <div class="fade-card-container">

            <div id="flashcard"
                 class="fade-card"
                 role="button"
                 tabindex="0"
                 aria-label="Покажи или скрий превода"
                 aria-pressed="false">

                <div id="cardContent" class="fade-card-content">

                    <span id="cardLabel" class="fade-card-label"></span>

                    <h2 id="cardWord"></h2>

                    <div id="cardAnswer" hidden>

                        <h3 id="cardTranslation"></h3>

                        <p>
                            <strong>Синоними:</strong>
                            <span id="cardSynonyms"></span>
                        </p>

                        <p>
                            <strong>Пример:</strong>
                            <span id="cardExample"></span>
                        </p>

                        <span id="cardLevel"
                              class="fade-card-level"></span>

                    </div>

                    <p id="cardHint" class="mt-3">
                        Натисни, за да видиш превода
                    </p>

                </div>
            </div>

        </div>

        <div class="mt-4 d-flex justify-content-center gap-2 flex-wrap">

            <button id="prevBtn"
                    type="button"
                    class="btn btn-outline-primary"
                    onclick="previousCard()">
                Предишна
            </button>

            <button type="button"
                    class="btn btn-primary"
                    onclick="flipCard()">
                Обърни картата
            </button>

            <button id="nextBtn"
                    type="button"
                    class="btn btn-outline-primary"
                    onclick="nextCard()">
                Следваща
            </button>

        </div>
    </div>
}

@if (Model.Any())
{
    <script>
        const words = @Html.Raw(
                                    System.Text.Json.JsonSerializer.Serialize(
                                            Model.Select(w => new
                                            {
                                                    text = w.Text,
                                                    translation = w.Translation,
                                                    synonyms = w.Synonyms,
                                                    example = w.Example,
                                                    level = w.DifficultyLevel
                                        })
                                )
                            );

        let currentIndex = 0;
        let isFlipped = false;
                let isAnimating = false;

            const flashcard = document.getElementById("flashcard");
                const cardContent = document.getElementById("cardContent");

              const reduceMotion = window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                );

                function showCard() {
            const word = words[currentIndex];

                    document.getElementById("cardWord").textContent =
                word.text;

                    document.getElementById("cardTranslation").textContent =
                word.translation;

                    document.getElementById("cardSynonyms").textContent =
                word.synonyms || "Няма";

                document.getElementById("cardExample").textContent =
                        word.example || "Няма";

                document.getElementById("cardLevel").textContent =
                        word.level || "Няма ниво";

                document.getElementById("cardCounter").textContent =
                        `Карта ${currentIndex + 1} от ${words.length}`;

                document.getElementById("cardWord").hidden = isFlipped;
                    document.getElementById("cardAnswer").hidden = !isFlipped;
            document.getElementById("cardHint").hidden = isFlipped;

            document.getElementById("cardLabel").textContent =
                        isFlipped ? " " : "КАКВО ОЗНАЧАВА:";

            flashcard.classList.toggle("show-answer", isFlipped);

            flashcard.setAttribute(
                        "aria-pressed",
                String(isFlipped)
            );

                document.getElementById("prevBtn").disabled =
                currentIndex === 0;

            document.getElementById("nextBtn").disabled =
                        currentIndex === words.length - 1;
        }

            function animateChange(updateFunction) {
                if (isAnimating) return;

            if (reduceMotion.matches) {
                updateFunction();
                        showCard();
                return;
            }

            isAnimating = true;

                    cardContent.classList.add("fade-out");

                    setTimeout(() => {
                        updateFunction();
                        showCard();

                        cardContent.classList.remove("fade-out");

                        setTimeout(() => {
                            isAnimating = false;
                        }, 260);

                    }, 260);
                }

                function flipCard() {
                    animateChange(() => {
                        isFlipped = !isFlipped;
                    });
                }

                function changeCard(newIndex) {
                    if (newIndex < 0 || newIndex >= words.length) {
                        return;
                    }

                    animateChange(() => {
                        currentIndex = newIndex;
                        isFlipped = false;
                    });
                }

                function nextCard() {
                    changeCard(currentIndex + 1);
                }

                function previousCard() {
                    changeCard(currentIndex - 1);
                }

                flashcard.addEventListener("click", flipCard);

                flashcard.addEventListener("keydown", function (event) {
                    if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        flipCard();
                    }
                });

                showCard();
    </script>
}
